{
  "name": "@useoutlet/sdk",
  "version": "0.6.1",
  "description": "Connect your users' AI accounts to your app. Capped, revocable App keys, never raw credentials. Outlet is never in the data path.",
  "license": "MIT",
  "author": "Parz <hello@useoutlet.dev>",
  "homepage": "https://useoutlet.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PARZ1V3L/outlet.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/PARZ1V3L/outlet/issues",
    "email": "hello@useoutlet.dev"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./providers.json": "./dist/providers.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/write-providers-json.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "ai",
    "byok",
    "bring-your-own-key",
    "api-keys",
    "api-key-management",
    "llm",
    "anthropic",
    "openai",
    "google",
    "gemini",
    "oauth",
    "outlet",
    "typescript",
    "react",
    "vue",
    "mcp",
    "openrouter",
    "fal",
    "widget",
    "connect-your-ai"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
